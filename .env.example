# --- Variables del compose de producción (Dokploy → Environment) ---------------
# Ningún valor con «$»: Dokploy y Docker Compose los interpolan. Secretos en hex.

# Dominio público (Traefik + Let's Encrypt). Sin https://.
APP_HOST=

# Postgres propio del proyecto. La contraseña NO se cambia tras el primer
# despliegue: el volumen se queda con la primera.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Firma de la cookie de sesión y clave que cifra los secretos guardados en la
# base (contraseña del SMTP). Si se pierde CLAVE_CIFRADO, hay que volver a
# escribir la contraseña del SMTP en el panel.
SECRETO_SESION=
CLAVE_CIFRADO=

# Superadmin fijo: usuario y contraseña en claro. Cambiarla y redesplegar es la
# forma de recuperar el acceso.
SUPERADMIN_USUARIO=
SUPERADMIN_CONTRASENA=

# true = no sale ningún correo (se registra en la traza). Activarlo es una
# decisión explícita, después de probar el SMTP desde el panel.
CORREO_DRY_RUN=

# NIVEL_LOG=info

# --- Solo para desarrollo local (api/.env, con `npm run dev`) -----------------
# DATABASE_URL=postgres://bambu:bambu_local@localhost:5438/bambu
# URL_PUBLICA=http://localhost:8105
# COOKIE_SEGURA=false
# PUERTO_API=8105
